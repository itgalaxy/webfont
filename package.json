{
  "name": "webfont",
  "version": "11.5.21",
  "description": "Generator of fonts from svg icons, svg icons to svg font, svg font to ttf, ttf to eot, ttf to woff, ttf to woff2",
  "directories": {
    "lib": "dist",
    "source": "src"
  },
  "files": [
    "dist",
    "dist/src/index.d.ts",
    "templates",
    "!**/__tests__",
    "!**/__mocks__",
    "README.md"
  ],
  "main": "dist/index.js",
  "bin": "dist/cli.mjs",
  "source": "src/index.ts",
  "types": "dist/src/index.d.ts",
  "typings": "dist/src/index.d.ts",
  "scripts": {
    "build": "vite build --mode library && vite build --mode cli",
    "clean": "rm -rf dist/ temp/",
    "demo": "node dist/cli.mjs './src/fixtures/svg-icons/*.svg' -d demo -t html --normalize --center-horizontally",
    "lint": "biome check .",
    "prebuild": "npm run clean && npm run lint",
    "prepare": "lefthook install",
    "predemo": "npm run build",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "prettify": "biome check --write .",
    "test": "vitest run src",
    "testc": "vitest run src --coverage",
    "test-debug": "vitest run src --no-file-parallelism",
    "testu": "vitest run src -u"
  },
  "dependencies": {
    "cosmiconfig": "9.0.2",
    "deepmerge": "^4.2.2",
    "globby": "16.2.0",
    "meow": "14.1.0",
    "nunjucks": "3.2.4",
    "p-limit": "7.3.0",
    "parse-json": "^5.2.0",
    "resolve-from": "^5.0.0",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^16.0.0",
    "ttf2eot": "3.1.0",
    "ttf2woff": "^3.0.0",
    "wawoff2": "^2.0.0",
    "xml2js": "0.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@vitest/coverage-v8": "4.1.9",
    "@types/node": "^22.15.0",
    "@types/nunjucks": "3.2.6",
    "@types/rimraf": "latest",
    "@types/svg2ttf": "5.0.3",
    "@types/ttf2eot": "2.0.2",
    "@types/ttf2woff": "2.0.4",
    "@types/wawoff2": "1.0.2",
    "@types/xml2js": "0.4.14",
    "is-eot": "latest",
    "is-svg": "6.1.0",
    "is-ttf": "latest",
    "is-woff": "latest",
    "is-woff2": "latest",
    "vitest": "4.1.9",
    "lefthook": "2.1.9",
    "rimraf": "latest",
    "ts-node": "latest",
    "tslib": "latest",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vite-plugin-checker": "0.14.4",
    "vite-plugin-dts": "5.0.3"
  },
  "overrides": {
    "fast-glob": "3.2.12",
    "minimatch": "10.2.5",
    "test-exclude": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itgalaxy/webfont.git"
  },
  "author": "itgalaxy <development@itgalaxy.company>",
  "license": "MIT",
  "contributors": [
    {
      "name": "Alexander Krasnoyarov",
      "email": "alexander.krasnoyarov@itgalaxy.company",
      "url": "https://vk.com/sterling_archer"
    },
    {
      "name": "Jimmy Andrade",
      "email": "webfont@jimmyandrade.com",
      "url": "https://github.com/jimmyandrade"
    }
  ],
  "bugs": {
    "url": "https://github.com/itgalaxy/webfont/issues"
  },
  "homepage": "https://github.com/itgalaxy/webfont#readme",
  "engines": {
    "node": ">= 24.14.0"
  },
  "keywords": [
    "cli",
    "standalone",
    "font",
    "fonts",
    "webfont",
    "webfonts",
    "svg",
    "ttf",
    "woff",
    "woff2",
    "otf",
    "ttf2eot",
    "ttf2woff",
    "ttf2svg",
    "svg2ttf",
    "css",
    "scss",
    "builder",
    "generator"
  ]
}
