{
  "name": "webfont-mcp",
  "private": true,
  "description": "Local MCP server wrapping webfont() for agents (not published)",
  "type": "module",
  "bin": {
    "webfont-mcp": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build -w webfont && npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "globby": "16.2.3",
    "webfont": "file:../webfont",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
