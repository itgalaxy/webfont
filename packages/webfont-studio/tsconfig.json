{
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "paths": {
      "@webfont/*": ["../webfont/src/*"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": ["dist"]
}
