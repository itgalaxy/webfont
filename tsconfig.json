{
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "strictNullChecks": false,
    "outDir": "dist",
    "resolveJsonModule": true,
    "rootDir": ".",
    "skipLibCheck": false,
    "target": "ES2020"
  },
  "exclude": ["jest.config.ts", "jest/**", "src/**/*.test.ts"]
}
